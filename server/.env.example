# 充电桩后端环境变量示例
#
# 用法：cp server/.env.example server/.env 后按需修改。
# server/.env 已在 .gitignore 里，不要把真实密钥提交进仓库。
# 容器与托管平台请直接注入环境变量，优先级高于本文件。
#
# 完整上线步骤见 docs/PRODUCTION.md。

# ---------------------------------------------------------------- 运行环境
# development | production
# production 会：强制要求 JWT_SECRET、CORS 默认不放通配、关闭演示重置接口
NODE_ENV=development

# 监听地址。容器里必须是 0.0.0.0，否则宿主机映射不进来
HOST=127.0.0.1
PORT=3000

# ---------------------------------------------------------------- 持久化
# 数据目录（相对路径以仓库根目录为基准）。容器部署请挂载成卷，否则重启即丢
DATA_DIR=./.data
# 设为 0 回到纯内存演示行为（进程退出数据清空）
PERSIST=1
# 写入后最多延迟多少毫秒落盘
PERSIST_FLUSH_MS=200

# ---------------------------------------------------------------- 鉴权
# 令牌签名密钥。生产必填，缺失会直接启动失败。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 令牌有效期（秒），默认 7 天
TOKEN_TTL_SEC=604800

# 微信小程序凭证。两个都填上后 /api/auth/login 会真的去调 code2session；
# 留空则走 mock 登录（任何 code 都换到同一个演示账号），并在启动日志里告警。
WX_APPID=
WX_SECRET=

# ---------------------------------------------------------------- 跨域
# 逗号分隔的来源白名单，例如 https://admin.example.com
# 留空且 NODE_ENV=production 时不下发跨域头（小程序 wx.request 不受同源策略限制，
# 正式环境通常就该留空）。开发模式默认 *。
CORS_ORIGIN=

# ---------------------------------------------------------------- 加固
# 单个请求体上限（字节）
MAX_BODY_BYTES=262144
# 限流：每个 IP 在 RATE_LIMIT_WINDOW_MS 毫秒内最多 RATE_LIMIT_MAX 次请求
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
# 访问日志
ACCESS_LOG=1
# 演示能力（POST /api/reset、余额沙箱支付）。生产默认关闭
DEMO_MODE=

# ---------------------------------------------------------------- 微信支付
# 本版本**没有**接入真实微信支付。填了这两个变量也只会让 /api/orders/:id/pay
# 的错误提示从「未配置商户号」变成「未实现下单」——接入步骤见 docs/PRODUCTION.md。
WXPAY_MCHID=
WXPAY_API_KEY=
