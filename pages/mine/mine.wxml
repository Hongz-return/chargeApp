<view class="page">
  <!-- 用户信息 -->
  <view class="profile">
    <view class="profile-main">
      <view class="avatar">{{user.avatarText}}</view>
      <view class="profile-info">
        <view class="nickname">
          {{user.nickName}}
          <text class="level">{{user.memberLevel}}</text>
        </view>
        <view class="phone">{{phoneText}}</view>
      </view>
      <view class="plate" bindtap="onEditPlate">
        <text class="plate-no">{{user.plateNo}}</text>
        <text class="plate-edit">修改</text>
      </view>
    </view>

    <!-- 钱包 -->
    <view class="wallet-card">
      <view class="wallet-left" bindtap="onWalletTap">
        <view class="wallet-label">账户余额（元）</view>
        <view class="wallet-balance">{{balance}}</view>
      </view>
      <view class="wallet-right">
        <view class="wallet-cell" bindtap="onCouponTap">
          <view class="wallet-cell-value">{{couponCount}}</view>
          <view class="wallet-cell-label">优惠券</view>
        </view>
        <view class="wallet-cell" bindtap="onFavoriteTap">
          <view class="wallet-cell-value">{{favoriteCount}}</view>
          <view class="wallet-cell-label">收藏</view>
        </view>
        <view class="recharge-btn" bindtap="onWalletTap">充值</view>
      </view>
    </view>
  </view>

  <!-- 充电统计 -->
  <view class="card">
    <view class="section-title">
      我的充电
      <text class="section-sub">{{statsSource}}</text>
    </view>
    <view class="stat-grid">
      <view class="stat-cell">
        <view class="stat-value">{{stats.orderCount}}</view>
        <view class="stat-label">充电次数</view>
      </view>
      <view class="stat-cell">
        <view class="stat-value">{{stats.totalEnergyText}}</view>
        <view class="stat-label">累计电量（度）</view>
      </view>
      <view class="stat-cell">
        <view class="stat-value">¥{{stats.totalCostText}}</view>
        <view class="stat-label">累计消费</view>
      </view>
      <view class="stat-cell">
        <view class="stat-value {{stats.unpaidCount > 0 ? 'warn' : ''}}">{{stats.unpaidCount}}</view>
        <view class="stat-label">待支付</view>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="card">
    <view class="quick-grid">
      <view class="quick-item" bindtap="onOrdersTap">
        <view class="quick-icon bg-green"><view class="ic ic-doc"></view></view>
        <view class="quick-label">全部订单</view>
      </view>
      <view class="quick-item" bindtap="onChargingTap">
        <view class="quick-icon bg-orange"><view class="ic ic-bolt"></view></view>
        <view class="quick-label">
          充电中
          <text wx:if="{{hasCharging}}" class="quick-dot"></text>
        </view>
      </view>
      <view class="quick-item" bindtap="onFavoriteTap">
        <view class="quick-icon bg-red"><view class="ic ic-heart"></view></view>
        <view class="quick-label">我的收藏</view>
      </view>
      <view class="quick-item" bindtap="onCouponTap">
        <view class="quick-icon bg-blue"><view class="ic ic-ticket"></view></view>
        <view class="quick-label">优惠券</view>
      </view>
    </view>
  </view>

  <!-- 常用功能 -->
  <view class="card">
    <view class="list-row" bindtap="onWalletTap">
      <view class="row-icon"><view class="ic ic-wallet"></view></view>
      <text class="row-label">我的钱包</text>
      <text class="row-value">¥{{balance}}</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="list-row" bindtap="onInvoiceTap">
      <view class="row-icon"><view class="ic ic-doc"></view></view>
      <text class="row-label">发票管理</text>
      <text class="row-value">{{invoiceCount > 0 ? invoiceCount + ' 条记录' : ''}}</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="list-row" bindtap="onVehicleTap">
      <view class="row-icon"><view class="ic ic-car"></view></view>
      <text class="row-label">我的车辆</text>
      <text class="row-value">{{user.carModel}}</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="list-row" bindtap="onServiceTap">
      <view class="row-icon"><view class="ic ic-chat"></view></view>
      <text class="row-label">帮助与客服</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="list-row" bindtap="onAbout">
      <view class="row-icon"><view class="ic ic-info"></view></view>
      <text class="row-label">演示说明与隐私</text>
      <text class="row-value">v{{version}}</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="list-row" bindtap="onOpenTerms">
      <view class="row-icon"><view class="ic ic-doc"></view></view>
      <text class="row-label">用户服务协议</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="list-row" bindtap="onOpenPrivacy">
      <view class="row-icon"><view class="ic ic-doc"></view></view>
      <text class="row-label">隐私政策</text>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="list-row danger-row" bindtap="onResetData">
      <view class="row-icon"><view class="ic ic-trash"></view></view>
      <text class="row-label">清除本地数据</text>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <!-- 演示与隐私声明（常驻） -->
  <view class="card notice-card">
    <view class="notice-title">
      <view class="ic ic-info"></view>
      <text class="notice-title-text">演示版声明</text>
    </view>
    <view class="notice-item">本小程序为<text class="notice-strong">演示版</text>，用于展示充电桩业务的完整交互流程。</view>
    <view class="notice-item">全部站点、充电过程与支付均为本地模拟，<text class="notice-strong">不会产生真实充电，也不会真实扣款</text>。</view>
    <view class="notice-item">不采集、不上传任何个人信息；订单、钱包、收藏等数据只写入本机 Storage，可在上方「清除本地数据」一键删除。</view>
    <view class="notice-item">无需联网即可完整体验，断网时功能不受影响。</view>
    <view class="notice-more" bindtap="onAbout">查看完整演示说明 ›</view>
  </view>

  <view class="footer-note">
    注册于 {{user.joinedAt}} · 演示数据仅保存在本机
  </view>

  <charging-bar bottom="{{40}}" />
</view>
