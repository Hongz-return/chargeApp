.page {
  padding-bottom: 240rpx;
}

/* -------------------------------------------------------------- 站点概览 */

.hero {
  background: linear-gradient(160deg, #07c160 0%, #06ad56 46%, #f3f5f7 46%, #f3f5f7 100%);
  padding: 24rpx 24rpx 0;
}

.hero-top {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 4rpx 16rpx rgba(15, 34, 58, 0.08);
}

.hero-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  flex-shrink: 0;
  background: #eef0f2;
}

.theme-green {
  background: linear-gradient(135deg, #e6f9ee, #cdf1de);
  color: #06a557;
}

.theme-blue {
  color: #2f6fe0;
}

.theme-orange {
  color: #e07a00;
}

.theme-purple {
  color: #6b4fd8;
}

.theme-blue {
  background: linear-gradient(135deg, #e8f0ff, #d5e3ff);
}

.theme-orange {
  background: linear-gradient(135deg, #fff2e0, #ffe3c2);
}

.theme-purple {
  background: linear-gradient(135deg, #f0ebff, #e2d9ff);
}

.hero-title {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}

.hero-name {
  font-size: 33rpx;
  font-weight: 600;
  line-height: 1.35;
}

.hero-meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.hero-meta .dot {
  margin: 0 8rpx;
}

.hero-meta .rating {
  color: #ff8a00;
}

.hero-fav {
  font-size: 40rpx;
  color: #c8ccd0;
  line-height: 1;
  flex-shrink: 0;
  padding: 4rpx 0 0 8rpx;
}

.hero-fav.on {
  color: #fa5151;
}

.sb-check {
  display: inline-block;
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 20rpx;
  margin-right: 10rpx;
}

.scan-banner {
  margin-top: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 23rpx;
  color: #06ad56;
}

.hero-tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  row-gap: 10rpx;
}

.hero-actions {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(15, 34, 58, 0.05);
}

.hero-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 23rpx;
  color: var(--text-2);
  border-right: 1rpx solid var(--line);
}

.hero-action:last-child {
  border-right: none;
}

.hero-action:active {
  opacity: 0.7;
}

.ha-icon {
  font-size: 34rpx;
  margin-bottom: 10rpx;
  color: var(--brand);
}

/* --------------------------------------------------------------- 价格 */

.price-row {
  display: flex;
  align-items: baseline;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line);
}

.price-num {
  font-size: 44rpx;
}

.price-detail {
  margin-left: 20rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.price-rules {
  display: flex;
}

.rule {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-right: 1rpx solid var(--line);
}

.rule:last-child {
  border-right: none;
}

.rule-label {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: var(--text-2);
}

.rule-valley {
  background: var(--brand-light);
  color: var(--brand);
}

.rule-flat {
  background: var(--info-light);
  color: var(--info);
}

.rule-peak {
  background: var(--accent-light);
  color: #ff6f00;
}

.rule-period {
  font-size: 22rpx;
  color: var(--muted);
  margin: 12rpx 0 8rpx;
}

.rule-price {
  font-size: 30rpx;
  font-weight: 600;
}

/* ------------------------------------------------------------- 充电枪 */

.pile-filter {
  display: flex;
  margin-bottom: 20rpx;
}

.pf-item {
  padding: 8rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-2);
  background: #f4f5f7;
}

.pf-item.active {
  background: var(--brand-light);
  color: var(--brand);
  font-weight: 500;
}

.pile-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pile {
  position: relative;
  width: calc((100% - 16rpx) / 2);
  border: 2rpx solid #e9ebee;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.pile.busy,
.pile.offline {
  opacity: 0.55;
  background: #fafbfc;
}

.pile.selected {
  border-color: var(--brand);
  background: #f2fbf6;
  box-shadow: 0 4rpx 14rpx rgba(7, 193, 96, 0.14);
}

.pile-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pile-name {
  font-size: 34rpx;
  font-weight: 700;
}

.pile-top .tag {
  margin-right: 0;
}

.pile-power {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 12rpx;
}

.pile-connector {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.pile-check {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 16rpx 0 14rpx 0;
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* --------------------------------------------------------------- 地图 */

.map-card {
  padding-bottom: 20rpx;
}

.mini-map {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
}

.map-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 14rpx;
}

/* --------------------------------------------------------------- 底部 */

.footer-info {
  font-size: 23rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
  text-align: center;
}

.footer-strong {
  color: var(--brand);
  font-weight: 600;
}
