.page {
  padding-bottom: 160rpx;
}

/* 充电中圆环 */
.ring-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 20rpx;
}

.ring {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: conic-gradient(var(--brand) 0deg, #a6e8c3 200deg, #e8f8ee 360deg);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: breathe 2s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

.ring-inner {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.energy-num {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--brand);
}

.energy-unit {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.charging-hint {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--muted);
}

/* 数据统计 */
.stat-row {
  display: flex;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
}

.stat-cost {
  color: #ff6f00;
}

.stat-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.session-info {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 完成状态 */
.done-icon-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 20rpx;
}

.done-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.done-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
}

/* 账单 */
.bill-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 28rpx;
}

.bill-label {
  color: var(--muted);
}

.bill-total {
  border-top: 1rpx solid #f0f0f0;
  margin-top: 12rpx;
  padding-top: 24rpx;
}

.bill-total .bill-label {
  color: #333;
  font-weight: 600;
}

.bill-total .bill-value {
  color: #ff6f00;
  font-size: 34rpx;
  font-weight: 700;
}

/* 底部按钮 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}
