.page {
  padding-bottom: 40rpx;
}

/* ---------------------------------------------------------------- 头部 */

.hero {
  background: linear-gradient(160deg, #07c160 0%, #06a557 100%);
  padding: 50rpx 40rpx 60rpx;
  color: #fff;
  text-align: center;
}

.hero-logo {
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 22rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 600;
}

.hero-badge {
  display: inline-block;
  margin-top: 14rpx;
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.24);
  padding: 5rpx 20rpx;
  border-radius: 999rpx;
}

.hero-sub {
  font-size: 23rpx;
  opacity: 0.9;
  margin-top: 16rpx;
}

/* -------------------------------------------------------------- 演示声明 */

.st-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.st-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.st-index {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--brand-light);
  color: var(--brand-dark);
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
  flex-shrink: 0;
  margin-top: 3rpx;
}

.st-main {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.st-title {
  font-size: 27rpx;
  font-weight: 600;
}

.st-text {
  font-size: 23rpx;
  color: var(--text-2);
  line-height: 1.7;
  margin-top: 8rpx;
}

/* ------------------------------------------------------------ 存储数据 */

.kv-row {
  display: flex;
  align-items: baseline;
  font-size: 23rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.kv-row:last-of-type {
  border-bottom: none;
}

.kv-key {
  width: 240rpx;
  flex-shrink: 0;
  color: var(--brand-dark);
  font-family: 'SF Mono', Menlo, Consolas, monospace;
}

.kv-desc {
  flex: 1;
  color: var(--text-2);
  line-height: 1.6;
}

.card-tip {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.7;
}

/* -------------------------------------------------------------- 演示边界 */

.limit-row {
  display: flex;
  align-items: flex-start;
  font-size: 23rpx;
  line-height: 1.7;
  margin-top: 12rpx;
}

.limit-mark {
  color: #c8ccd0;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.limit-text {
  flex: 1;
  color: var(--text-2);
}

/* ---------------------------------------------------------------- 分享 */

.share-btn {
  background: var(--brand-light);
  color: var(--brand-dark);
  font-size: 28rpx;
  line-height: 84rpx;
  height: 84rpx;
  border-radius: 999rpx;
  border: none;
}

.share-btn::after {
  border: none;
}

.footer-note {
  text-align: center;
  font-size: 21rpx;
  color: #b6bbc0;
  padding: 30rpx 50rpx 60rpx;
  line-height: 1.7;
}
