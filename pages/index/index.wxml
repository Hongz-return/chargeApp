<view class="page">
  <!-- 顶部搜索区 -->
  <view class="header">
    <view class="header-top">
      <view class="location">
        <view class="location-icon ic ic-pin"></view>
        <text class="location-text">深圳 · 南山科技园</text>
      </view>
      <view class="view-toggle" bindtap="onToggleView">
        <view class="ic {{viewMode === 'list' ? 'ic-map' : 'ic-list'}}"></view>
        <text class="view-toggle-text">{{viewMode === 'list' ? '地图' : '列表'}}</text>
      </view>
    </view>

    <view class="search-row">
      <view class="search-box">
        <view class="search-icon ic ic-search"></view>
        <input
          class="search-input"
          value="{{keyword}}"
          placeholder="搜索充电站名称 / 地址 / 运营商"
          placeholder-class="search-placeholder"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <text wx:if="{{keyword}}" class="search-clear" catchtap="onClearKeyword">✕</text>
      </view>
      <view class="scan-btn" bindtap="onScanTap">
        <view class="scan-icon ic ic-scan"></view>
        <text class="scan-text">扫码</text>
      </view>
    </view>

    <!-- 筛选 -->
    <scroll-view class="chip-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="chip-row">
        <view
          wx:for="{{filters}}"
          wx:key="key"
          class="chip {{filter === item.key ? 'active' : ''}}"
          data-filter="{{item.key}}"
          bindtap="onFilterTap"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <!-- 排序 -->
    <scroll-view class="chip-scroll sort-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="chip-row">
        <text class="sort-label">排序</text>
        <view
          wx:for="{{sorts}}"
          wx:key="key"
          class="sort-item {{sort === item.key ? 'active' : ''}}"
          data-sort="{{item.key}}"
          bindtap="onSortTap"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 首次进入的演示声明（关闭后不再出现，状态存在本机） -->
  <view wx:if="{{showNotice}}" class="demo-notice">
    <view class="dn-icon ic ic-info"></view>
    <view class="dn-main">
      <view class="dn-title">演示版小程序</view>
      <view class="dn-text">站点、充电与支付均为本地模拟，不联网、不产生真实充电与真实扣款。</view>
    </view>
    <view class="dn-close" catchtap="onCloseNotice">✕</view>
  </view>

  <!-- 列表模式 -->
  <block wx:if="{{viewMode === 'list'}}">
    <skeleton wx:if="{{loading}}" count="{{4}}" />

    <block wx:else>
      <view wx:if="{{stations.length > 0}}" class="result-bar">
        为你找到 <text class="result-num">{{stats.total}}</text> 个充电站，共 <text class="result-num">{{stats.idle}}</text> 个空闲枪
      </view>

      <station-card
        wx:for="{{stations}}"
        wx:key="id"
        station="{{item}}"
        favorite="{{item.isFavorite}}"
        show-favorite="{{true}}"
        bind:select="onStationTap"
        bind:favorite="onFavoriteTap"
      />

      <empty
        wx:if="{{stations.length === 0}}"
        icon="plug"
        text="没有找到符合条件的充电站"
        sub="换个关键词，或把筛选条件调整为「全部」试试"
      />

      <view wx:if="{{stations.length > 0}}" class="list-end">— 已显示全部站点 —</view>
    </block>
  </block>

  <!-- 地图模式 -->
  <block wx:else>
    <view class="map-wrap">
      <map
        id="stationMap"
        class="station-map"
        latitude="{{mapCenter.latitude}}"
        longitude="{{mapCenter.longitude}}"
        scale="{{12}}"
        markers="{{markers}}"
        show-location="{{false}}"
        enable-poi="{{false}}"
        bindmarkertap="onMarkerTap"
        bindtap="onMapTap"
      ></map>

      <view class="map-recenter" bindtap="onRecenter">
        <view class="ic ic-locate"></view>
      </view>

      <view wx:if="{{selectedStation}}" class="map-preview">
        <station-card
          station="{{selectedStation}}"
          favorite="{{selectedStation.isFavorite}}"
          show-favorite="{{true}}"
          bind:select="onStationTap"
          bind:favorite="onFavoriteTap"
        />
      </view>
      <view wx:elif="{{stations.length === 0}}" class="map-tip">
        当前条件下没有充电站，换个关键词或把筛选调整为「全部」
      </view>
      <view wx:else class="map-tip">点击地图上的绿色标记查看充电站详情</view>
    </view>
  </block>

  <charging-bar bottom="{{40}}" />

  <!-- 首次使用：用户协议与隐私政策同意（提审/上线前材料） -->
  <view wx:if="{{showConsent}}" class="consent-mask" catchtouchmove="noop">
    <view class="consent-card">
      <view class="consent-title">服务协议与隐私保护</view>
      <view class="consent-body">
        为符合微信小程序审核与上线合规要求，请阅读并同意相关条款。演示环境不会上传真实身份证件；正式环境的数据用途见隐私政策。
      </view>
      <view class="consent-check" bindtap="onToggleConsent">
        <view class="consent-box {{consentChecked ? 'on' : ''}}"></view>
        <view class="consent-check-text">
          我已阅读并同意
          <text class="consent-link" catchtap="onOpenTerms">《用户服务协议》</text>
          与
          <text class="consent-link" catchtap="onOpenPrivacy">《隐私政策》</text>
        </view>
      </view>
      <view class="consent-btn {{consentChecked ? '' : 'disabled'}}" bindtap="onAgreeLegal">同意并继续</view>
    </view>
  </view>
</view>
