{
  "description": "充电桩微信小程序（本地 mock 数据，无后端）",
  "miniprogramRoot": "./",
  "compileType": "miniprogram",
  "libVersion": "3.4.0",
  "appid": "touristappid",
  "projectname": "charging-pile-miniprogram",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "urlCheck": false,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "ignoreUploadUnusedFiles": true,
    "checkSiteMap": true,
    "useCompilerPlugins": false
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "tests" },
      { "type": "folder", "value": "tools" },
      { "type": "folder", "value": "docs" },
      { "type": "folder", "value": ".github" },
      { "type": "file", "value": "package.json" },
      { "type": "file", "value": "README.md" },
      { "type": "file", "value": "CHANGELOG.md" },
      { "type": "file", "value": ".gitignore" }
    ]
  },
  "condition": {
    "miniprogram": {
      "list": [
        { "name": "首页-附近充电桩", "pathName": "pages/index/index", "query": "", "scene": null },
        { "name": "站点详情-万象城", "pathName": "pages/detail/detail", "query": "id=st-001", "scene": null },
        { "name": "扫码进入-指定枪", "pathName": "pages/detail/detail", "query": "id=st-004&pileId=p-004-a1&from=scan", "scene": null },
        { "name": "我的订单", "pathName": "pages/orders/orders", "query": "", "scene": null },
        { "name": "我的", "pathName": "pages/mine/mine", "query": "", "scene": null },
        { "name": "我的钱包", "pathName": "pages/wallet/wallet", "query": "", "scene": null },
        { "name": "发票管理", "pathName": "pages/invoice/invoice", "query": "", "scene": null },
        { "name": "演示说明与隐私", "pathName": "pages/about/about", "query": "", "scene": null }
      ]
    }
  },
  "editorSetting": {
    "tabIndent": "space",
    "tabSize": 2
  }
}
